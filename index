      <use href="#blob" fill-opacity=".2" transform="translate(205 205) scale(.56) translate(-200 -200)"/>
      <use href="#blob" fill="#C98B86" fill-opacity=".25" transform="translate(210 210) scale(.34) translate(-200 -200)"/>
    </g>
  </svg>
  <span class="eyebrow hand">*a field notebook of maps*</span>
  <h1>Kara<br>Jueckstock</h1>
  <p class="tagline">Geographer &amp; storyteller · Lansing, Michigan</p>
  <nav class="legend hand" aria-label="Site sections">
