</section>

<svg class="river" viewBox="0 0 560 40" aria-hidden="true">
  <path d="M0,18 C90,36 160,2 250,20 S400,38 470,18 S540,6 560,22" fill="none" stroke="#1F4BFF" stroke-width="2" stroke-dasharray="6 7" stroke-linecap="round"/>
  <circle cx="250" cy="20" r="3.5" fill="#1F4BFF"/>
</svg>

<section id="about">
  <svg class="contours" viewBox="0 0 400 400" aria-hidden="true">
    <g fill="#C98B86">
      <use href="#blob2" fill-opacity=".14"/>
      <use href="#blob2" fill-opacity=".16" transform="translate(200 200) scale(.75) translate(-200 -200)"/>
      <use href="#blob2" fill-opacity=".18" transform="translate(195 205) scale(.5) translate(-200 -200)"/>
      <use href="#blob2" fill="#9AA77E" fill-opacity=".3" transform="translate(190 210) scale(.27) translate(-200 -200)"/>
    </g>
  </svg>
  <div class="about-wrap">
    <div class="about-text">
      <div class="greeting">Hello!</div>
      <p>I'm a geographer and a storyteller first. I'm a creative bridge between complex concepts and people whose curiosity outpaces their attention span.</p>
    </div>

    <div class="portrait">
      <div class="arch">
        <!-- To add your photo: upload it to CartoPortfolio, delete the compass <svg> below,
             and put this in its place:  <img src="CartoPortfolio/me.jpg" alt="Kara Jueckstock">  -->
        <svg viewBox="0 0 200 200" width="62%" aria-hidden="true">
          <g fill="none" stroke="#F3ECDD" stroke-width="2">
            <circle cx="100" cy="100" r="70"/>
            <circle cx="100" cy="100" r="58" stroke-dasharray="3 5"/>
          </g>
          <polygon points="100,22 112,100 100,178 88,100" fill="#F3ECDD"/>
          <polygon points="22,100 100,88 178,100 100,112" fill="#F3ECDD" fill-opacity=".7"/>
          <polygon points="100,22 112,100 100,100" fill="#3F4A26"/>
          <circle cx="100" cy="100" r="6" fill="#C98B86"/>
          <text x="100" y="16" text-anchor="middle" font-family="Caveat, cursive" font-size="20" fill="#F3ECDD">N</text>
        </svg>
      </div>
      <svg class="badge" viewBox="0 0 140 140" aria-hidden="true">
        <defs><path id="ring" d="M70,70 m-52,0 a52,52 0 1,1 104,0 a52,52 0 1,1 -104,0"/></defs>
        <circle cx="70" cy="70" r="66" fill="#F3ECDD" stroke="#3F4A26" stroke-width="1.5"/>
        <text font-family="EB Garamond, Georgia, serif" font-size="13" letter-spacing="3" fill="#3F4A26">
          <textPath href="#ring">GEOGRAPHER · STORYTELLER · MICHIGAN ·</textPath>
