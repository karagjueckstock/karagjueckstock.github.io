    <a href="#about"><span class="mark">2</span>about</a>
    <a href="#contact"><span class="mark">3</span>say hello</a>
  </nav>
</header>

<!-- dashed river divider -->
<svg class="river" viewBox="0 0 560 40" aria-hidden="true">
  <path d="M0,22 C70,2 140,40 210,20 S350,2 420,22 S530,36 560,18" fill="none" stroke="#1F4BFF" stroke-width="2" stroke-dasharray="6 7" stroke-linecap="round"/>
  <circle cx="210" cy="20" r="3.5" fill="#1F4BFF"/>
  <circle cx="420" cy="22" r="3.5" fill="#1F4BFF"/>
</svg>

<section id="maps">
  <svg class="sprig left" viewBox="0 0 120 260" aria-hidden="true"><use href="#sprigDraw"/></svg>
  <div class="section-title">
    <h2>The Maps</h2>
    <div class="note hand">*#30DayMapChallenge, November 2026*</div>
  </div>
  <div class="gallery">

    <!-- To add a map: upload the image into the CartoPortfolio folder, then copy one <figure>
         block and change the file name, day, title and caption. File names must match exactly. -->

    <figure class="map-card">
