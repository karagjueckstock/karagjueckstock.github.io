    </div>
  </div>
</section>

<svg class="river" viewBox="0 0 560 40" aria-hidden="true">
  <path d="M0,22 C70,2 140,40 210,20 S350,2 420,22 S530,36 560,18" fill="none" stroke="#1F4BFF" stroke-width="2" stroke-dasharray="6 7" stroke-linecap="round"/>
  <circle cx="420" cy="22" r="3.5" fill="#1F4BFF"/>
</svg>

<section id="contact" class="contact">
  <svg class="sprig right" viewBox="0 0 120 260" aria-hidden="true"><use href="#sprigDraw"/></svg>
  <div class="section-title">
    <h2>Say Hello</h2>
    <div class="note hand">*every map starts with a conversation*</div>
  </div>
  <p>Have a story hiding in your data? I'd love to help you tell it.</p>
  <div class="links hand">
    <a href="mailto:hello@example.com">email me</a>
    <a href="https://www.linkedin.com/in/your-profile" target="_blank" rel="noopener">linkedin</a>
  </div>
</section>

<footer>
  <div class="hand">*drawn with care in Lansing, Michigan*</div>
  <small>© 2026 KARA JUECKSTOCK</small>
</footer>

<div class="lightbox" id="lightbox" aria-hidden="true">
  <img id="lightbox-img" src="" alt="">
  <div class="caption hand" id="lightbox-caption"></div>
</div>

<script>
  const box = document.getElementById('lightbox');
  const boxImg = document.getElementById('lightbox-img');
  const boxCap = document.getElementById('lightbox-caption');
  document.querySelectorAll('.map-card').forEach(card => {
    card.addEventListener('click', () => {
      const img = card.querySelector('img');
      boxImg.src = img.src;
      boxImg.alt = img.alt;
      boxCap.textContent = card.querySelector('h3').textContent;
      box.classList.add('open');
    });
  });
  box.addEventListener('click', () => box.classList.remove('open'));
  document.addEventListener('keydown', e => { if (e.key === 'Escape') box.classList.remove('open'); });
</script>

</body>
</html>
